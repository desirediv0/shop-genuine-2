# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase / FCM service-account keys. These can send push as us to every user,
# so they must never be committed. The key is uploaded to Expo with
# `eas credentials` and does not belong in the repo at all.
*-firebase-adminsdk-*.json
*service-account*.json
*serviceaccount*.json
google-service-account*.json

# Locally built test APKs — large, and signed with the debug keystore
*.apk
*.aab
